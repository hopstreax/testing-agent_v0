# Solari Cloud Browser API Configuration
# Obtain your live API key at: https://console.getsolari.com
SOLARI_API_KEY=slr_live_your_solari_api_key_here

# Free-Tier LLM Provider API Keys (Used in Milestone 2 Slice 3+)
# Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Groq Cloud: https://console.groq.com
GROQ_API_KEY=
# Local Ollama Host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
