# Solari Cloud Browser API Configuration
# Obtain your live API key at: https://console.getsolari.com
SOLARI_API_KEY=slr_live_your_solari_api_key_here

# Free-Tier LLM Provider API Keys (Used in Milestone 2 Slice 3+)
# Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Groq Cloud: https://console.groq.com
GROQ_API_KEY=
# Local Ollama Host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# TraceKit Session Authentication (M8+)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
# Environment mode ("development" or "production")
ENVIRONMENT=development

# Google OAuth 2.0 Configuration (M8 Slice 2+)
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Expected redirect URI in local development:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
